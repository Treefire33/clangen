<?xml version="1.1" encoding="UTF-8"?>
<?xml-model href="../sprite_schema.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<spritesheets>
    <spritesheet_prototype name="eyes_prototype">
        <sprite_group name="YELLOW"/>
        <sprite_group name="AMBER"/>
        <sprite_group name="HAZEL"/>
        <sprite_group name="PALEGREEN"/>
        <sprite_group name="GREEN"/>
        <sprite_group name="BLUE"/>
