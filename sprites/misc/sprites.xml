    <spritesheet image="eyes" prototype="eyes_prototype" name_convention="prefix"/>
    <spritesheet image="eyes2" prototype="eyes_prototype" name_convention="prefix"/>
    
    <spritesheet image="fademask">
        <sprite_group name="fademask0" />
