        <sprite_group name="GREY"/>
        <sprite_group name="CYAN"/>
        <sprite_group name="EMERALD"/>
        <sprite_group name="HEATHERBLUE"/>
        <sprite_group name="SUNLITICE"/>
        
        <sprite_group name="COPPER"/>
        <sprite_group name="SAGE"/>
        <sprite_group name="COBALT"/>
        <sprite_group name="PALEBLUE"/>
        <sprite_group name="BRONZE"/>
