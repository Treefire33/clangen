        <sprite_group name="fadestarclan2" coordinate="2 0"/>
    </spritesheet>
    <spritesheet image="fadedarkforest">
        <sprite_group name="fadedf0" />
        <sprite_group name="fadedf1" coordinate="1 0"/>
        <sprite_group name="fadedf2" coordinate="2 0"/>
    </spritesheet>

    <spritesheet image="lightingnew">
        <sprite_group name="lighting" />
    </spritesheet>

    <spritesheet image="shadersnewwhite">
        <sprite_group name="shaders" />
    </spritesheet>
